# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (read by server/src/db.ts)
DATABASE_URL=

# Discord webhook for phase / winner announcements
DISCORD_WEBHOOK=

# osu! OAuth2 application credentials — https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=

# Secret used to sign session cookies
SESSION_SECRET=

# Public origin the site is served from
PUBLIC_BASE_URL=

# Comma-separated osu! user IDs granted admin access
ADMIN_OSU_IDS=

NODE_ENV=development

# Server runtime (read by server/src/index.ts)
API_PORT=3001
CLIENT_ORIGIN=http://localhost:8443
